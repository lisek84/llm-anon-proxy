# llm-anon-proxy — local environment overrides.
#
#   cp .env.example .env     # then uncomment and edit what you need
#
# docker compose up -d reads this file automatically and injects every
# uncommented ANONPROXY_* below into the proxy container (see env_file in
# docker-compose.yml). Lines left commented fall back to the defaults shown.
# This file is a template committed to the repo — your real .env is gitignored,
# so a proxy token or cert path you add here never leaves the machine.
#
# Values shown are the DEFAULTS. Booleans are the literal string true/false.

# ── Core ──────────────────────────────────────────────────────────────────────
# Per-project mapping namespace (same original -> same surrogate within it).
#ANONPROXY_CONTEXT=default
# The real upstream API.
#ANONPROXY_UPSTREAM=https://api.anthropic.com
# Listen address/port INSIDE the container. Leave these alone under Docker — the
# host mapping (127.0.0.1:8787) is set in docker-compose.yml, not here.
#ANONPROXY_HOST=127.0.0.1
#ANONPROXY_PORT=8787

# ── Detection tuning ──────────────────────────────────────────────────────────
# How domain sub-labels are handled: preserve (keep prod-db01 literal) or mask.
#ANONPROXY_SUBDOMAIN_POLICY=preserve
# Polish national IDs (PESEL/REGON always; NIP/REGON only in clear context).
#ANONPROXY_DETECT_PL_ID=true
# Also flag BARE 10-digit NIP / 9-digit REGON by checksum (higher recall, ~9%
# over-anonymization of timestamps/phones — safe direction, round-trips).
#ANONPROXY_DETECT_PL_ID_BARE=false

# ── Local LLM layer (optional, off by default) ────────────────────────────────
# Turn on the Ollama contextual layer. Start compose with: --profile llm
#ANONPROXY_LLM=false
# If the LLM is enabled but unreachable, block the request (never forward
# partially-anonymized data). Keep true.
#ANONPROXY_LLM_FAIL_CLOSED=true
# Detector model to pull/use.
#ANONPROXY_OLLAMA_MODEL=qwen3.5:4b
#ANONPROXY_OLLAMA_TIMEOUT=60
# NOTE: ANONPROXY_OLLAMA_HOST is fixed to the in-compose service URL
# (http://ollama:11434) in docker-compose.yml — do not set it here.

# ── Fail-closed toggles (default off) ─────────────────────────────────────────
# Block (not forward) a request carrying content the proxy can't scrub:
#ANONPROXY_BLOCK_UNSCANNABLE=false   # image / binary-document blocks
#ANONPROXY_BLOCK_UNKNOWN=false       # any endpoint other than the anonymized ones
#ANONPROXY_BLOCK_MCP=false           # requests carrying mcp_servers (url+token can't be anonymized)

# ── Remote use: auth + TLS (see docs/INSTALL.md) ──────────────────────────────
# Shared secret required as a URL path prefix for non-loopback deploys:
#   ANTHROPIC_BASE_URL=https://host:8787/<token>
#ANONPROXY_TOKEN=
# Serve HTTPS. Either auto-generate a self-signed pair:
#ANONPROXY_TLS=false
#ANONPROXY_TLS_SAN=proxy.mylan,10.0.0.5     # extra SANs for the self-signed cert
# …or point at your own / Let's Encrypt cert (then clients need no extra CA):
#ANONPROXY_TLS_CERT=/path/to/fullchain.pem
#ANONPROXY_TLS_KEY=/path/to/privkey.pem

# ── Isolation from the Claude Code agent (see docs/THREAT-MODEL.md) ───────────
# off | warn (default) | enforce. Enforce refuses to start unless it can confirm
# the agent's user cannot read the vault/secret key.
#ANONPROXY_ISOLATION=warn
# For enforce inside a container, pass the agent user's NUMERIC ids (the host
# username doesn't resolve in the container):
#   ANONPROXY_CLIENT_UID=$(id -u)
#   ANONPROXY_CLIENT_GIDS="$(id -G | tr ' ' ,)"
#ANONPROXY_CLIENT_UID=
#ANONPROXY_CLIENT_GIDS=
# The dedicated UID/GID the container runs as — deliberately NOT your user.
# Do NOT set these to $(id -u): that re-grants the agent access to the vault.
#ANONPROXY_UID=991
#ANONPROXY_GID=991

# ── Live dashboard (/ui) ──────────────────────────────────────────────────────
#ANONPROXY_UI=true
# Reveal REAL values on the dashboard (accept that the agent, sharing loopback,
# could then read them over HTTP). Default masks originals.
#ANONPROXY_UI_SHOW_ORIGINALS=false
# Re-show caught values on EVERY request, not only the first time.
#ANONPROXY_UI_VERBOSE=false
# Append a note to the system prompt telling the model to treat placeholders as
# real values and not investigate the anonymization.
#ANONPROXY_INJECT_HINT=false

# ── Audit trail (real original->surrogate log, 0600, never over HTTP) ─────────
#ANONPROXY_AUDIT=true

# NOTE: the data paths (ANONPROXY_DATA_DIR / ANONPROXY_DB / ANONPROXY_DICT /
# ANONPROXY_LEAKLOG / ANONPROXY_AUDIT_PATH) are wired to /app/data via the volume
# mounts in docker-compose.yml — overriding them here would break persistence.
# Set them only for a native (non-Docker) run.
