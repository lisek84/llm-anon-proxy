.venv/
__pycache__/
*.pyc
data/
dictionary.yaml

# Your local env overrides (may hold a proxy token, cert paths, etc.) — never
# commit it. The committed template is .env.example.
.env
!.env.example
*.key
*.db
*.db-wal
*.db-shm
rotate.log.jsonl
dictionary.generated.yaml

# Encrypted-dictionary workflow: the DECRYPTED plaintext must never leave the
# machine — never let it (or the encrypted blob) be committed.
*.decrypted
*.enc
dictionary.yaml.*
